{
	"info": {
		"_postman_id": "user-center-api-collection",
		"name": "用户中心 API 接口集合",
		"description": "用户中心后端系统的完整API接口测试集合",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "用户注册",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"123456\",\n  \"checkPassword\": \"123456\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/user/register",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"user",
						"register"
					]
				},
				"description": "用户注册接口，需要提供用户名、密码和确认密码"
			},
			"response": []
		},
		{
			"name": "用户登录",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"123456\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/user/login",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"user",
						"login"
					]
				},
				"description": "用户登录接口，登录成功后会返回用户信息和会话信息"
			},
			"response": []
		},
		{
			"name": "用户查询",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/user/search?username=test",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"user",
						"search"
					],
					"query": [
						{
							"key": "username",
							"value": "test",
							"description": "用户名，支持模糊查询"
						}
					]
				},
				"description": "根据用户名查询用户信息，支持模糊匹配"
			},
			"response": []
		},
		{
			"name": "用户删除",
			"request": {
				"method": "DELETE",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/user/delete?id=123456",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"user",
						"delete"
					],
					"query": [
						{
							"key": "id",
							"value": "123456",
							"description": "要删除的用户ID"
						}
					]
				},
				"description": "根据用户ID删除用户（逻辑删除）"
			},
			"response": []
		},
		{
			"name": "用户登出",
			"request": {
				"method": "POST",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/user/logout",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"user",
						"logout"
					]
				},
				"description": "用户登出接口，清除当前会话"
			},
			"response": []
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		}
	]
} 